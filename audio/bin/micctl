#!/bin/bash
# micctl -- mute, sidetone and the mute lamp for the desk microphone on macOS.
#
# The card IS the microphone here. Apps select "Sound BlasterX G6" and talk to
# it directly, macOS does the routing, and this script only provides the key
# that mutes it and the indicators that say so.
#
#   mute      sets CoreAudio's own mute flag on the CARD's capture side. The
#             flag is deliberately not the one an app can read: Chrome reads a
#             mute flag and Google Meet answers a deliberate Option+B with
#             "your microphone is muted" over the top of its own mute button.
#             See hw_mute().
#   sidetone  the card's own analog monitoring of the mic back to its output,
#             switched with mute. Zero latency, because the signal never
#             reaches the host -- and for the same reason it carries no gate.
#   lamp      the card's RGB as a mute indicator, because a mute the apps
#             cannot see is a mute nothing else will tell you about.
#
# WHAT USED TO BE HERE, AND WHY IT IS NOT
#
# This was a gated-microphone chain: physical mic -> SoX highpass and noise
# gate -> BlackHole 2ch, with BlackHole as the system default input so every
# app picked the gate up with no per-app setup. It worked and it measured well,
# and it is in the git history if it is ever wanted back.
#
# It went because the card kept re-enumerating on arrival at this Mac --
# clicking, lamp dropping out, off the USB bus and back on a ten-second cycle.
# The chain was NOT the cause: the cycling reproduces with every agent here
# booted out and no sox, micctl or dockctl process running at all, which is
# measured rather than assumed. But the chain was the biggest thing this Mac
# did to a freshly-arrived card -- a capture stream opened within a second of
# enumeration, a default-input change, and a kill/restart of sox on every one
# of those cycles -- so removing it removes this machine's whole contribution
# while the real cause is still open.
#
# What that costs, plainly: there is no noise gate any more. Meet, Slack and
# Teams gate on their own side, which was always the argument for the sidetone
# carrying no gate, and it is now the argument for there being no gate here at
# all. OBS and anything else wanting one has its own.
#
# What it buys beyond the card: nothing here opens the device until an app
# does, and that turns out to matter -- see ensure_input_source.

# No `set -e`. A device on the other side of a USB switch, a card
# mid-enumeration and a vendor CLI that fails are all normal conditions here,
# and aborting on the first one would turn a recoverable blip into a dead key.
set -uo pipefail

# Karabiner and launchd both run commands with a bare PATH that has no
# Homebrew, so SwitchAudioSource would simply not be found. Everything here
# resolves through PATH, so fix PATH once rather than absolutising every call.
PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

STATE_DIR="${MIC_STATE_DIR:-$HOME/.local/state/audio}"
MUTE_STATE_FILE="$STATE_DIR/muted"
# Only used by the volume fallback in hw_mute_by_volume, for hardware with no
# mute control of its own.
MUTE_VOLUME_FILE="$STATE_DIR/premute-gain"

# ---------------------------------------------------------------------------
# Tunables. Every one can be overridden from the environment, or permanently in
# ~/.config/audio/local.conf, which is not tracked by the repo -- device names
# are the one thing here that is genuinely per-machine.
# ---------------------------------------------------------------------------
LOCAL_CONF="${MIC_CONF:-$HOME/.config/audio/local.conf}"
# shellcheck source=/dev/null
[[ -r "$LOCAL_CONF" ]] && source "$LOCAL_CONF"

# The card. Left empty, everything here follows whatever macOS currently calls
# the default input, so a laptop with only a built-in mic needs no config.
MIC_DEVICE="${MIC_DEVICE:-}"
MIC_FALLBACK="${MIC_FALLBACK:-MacBook Pro Microphone}"

# Built by ../install.sh. macOS exposes the input source, the sidetone and a
# named device's capture mute flag in System Settings but ships no CLI for any
# of them, and SwitchAudioSource can only reach the mute flag on whatever is
# the *default* input.
COREAUDIO_CTL="${MIC_COREAUDIO_CTL:-$HOME/.local/libexec/micctl-coreaudio}"

# ---------------------------------------------------------------------------
# The two input settings this deliberately does NOT touch
# ---------------------------------------------------------------------------
# Both default OFF, and both were on before BlackHole went. The reason is the
# same for each: they existed to work around something the chain itself caused,
# and with the chain gone macOS appears to get them right unaided. Rather than
# keep a workaround for a problem that may no longer exist, they are unplugged
# and the mechanism is left here behind one variable each.
#
# Which input device is the system default. macOS re-picks this when a device
# appears, and it used to pick the card directly -- quietly taking the chain
# and its gate out of the path, which is what this was for. With no virtual
# device competing, the card being picked IS the wanted outcome. Set to 1 if
# macOS starts picking something else.
MIC_CLAIM_DEFAULT_INPUT="${MIC_CLAIM_DEFAULT_INPUT:-0}"

# Which physical input the card listens on, for a device with more than one
# behind a single USB interface. The G6 has four and comes back from a
# re-enumeration parked on "Line In", an empty jack, so every app records
# digital silence.
#
# This used to have to be POLLED, and that turns out to have been our own
# fault. Setting it before the chain opened the device did not survive:
# CoreAudio re-asserted its own idea of the source when it configured the
# device FOR CAPTURE, measured as correct on read-back and back to Line In
# 400ms later. With nothing here capturing, the selection holds -- sampled once
# a second over six seconds with the chain stopped, `External Mic` throughout.
# Set to 1 if an app opening the card ever knocks it back; `micctl status`
# flags a source that cannot carry a mic.
MIC_ASSERT_INPUT_SOURCE="${MIC_ASSERT_INPUT_SOURCE:-0}"
MIC_INPUT_SOURCE="${MIC_INPUT_SOURCE:-}"

# The card's own analog sidetone. Empty means "do not manage it".
#
# Volatile, and shared: the desk machine turns it OFF when it takes the card,
# because it monitors in software there. So this has to be asserted rather than
# assumed, and the mute key owns it -- muting the host cannot reach an analog
# tap that never leaves the device.
MIC_SIDETONE="${MIC_SIDETONE:-}"
MIC_SIDETONE_DB="${MIC_SIDETONE_DB:-6}"

# The card's lamp as a mute indicator. Muting switches the sidetone off as
# well, so you can hear that you are muted -- but only while you are talking,
# and nothing else shows it: a mute on the capture side is deliberately
# invisible to every app. A colour tells you at a glance.
#
# Both empty means "do not touch the lighting", which is right for a device
# that has none. "R G B", 0-255 each. Needs the third-party G6 CLI, which is
# the only way to reach these: the lamp is a vendor HID setting, not an audio
# control, and that distinction runs through everything below.
MIC_RGB_MUTED="${MIC_RGB_MUTED:-}"
MIC_RGB_LIVE="${MIC_RGB_LIVE:-}"
G6_CLI="${G6_CLI:-$HOME/.local/share/g6-cli-venv/bin/soundblaster-x-g6-cli}"

# ---------------------------------------------------------------------------
# Warm-up
# ---------------------------------------------------------------------------
# How long the card has to have been continuously attached and answering before
# the one firmware write here is aimed at it.
#
# A card arriving across a USB switch is listed by CoreAudio before it will
# accept a write, and writing inside that window is how the docking on
# 2026-10-08 went wrong. dock-watch.log:
#
#   applying: docked
#     microphone: could not reach it (could not mute 'Sound BlasterX G6')
#
# The dock state changes when the desk KEYBOARD appears, and the card is a
# separate device behind the same switch -- so the keyboard being up means the
# card is on its way, never that it is ready.
#
# The twelve seconds is measured rather than chosen. While the card was cycling
# it was visible for under three seconds at a time on a ten-second period, so a
# settle window shorter than that period could be satisfied inside a single
# appearance of a card that is still restarting, which is the one case this
# exists to catch. The window has to beat the period, not merely feel generous.
MIC_SETTLE_SECONDS="${MIC_SETTLE_SECONDS:-12}"
# Nothing here watches continuously any more -- there is no poll loop left, only
# whatever asks. So "continuously attached" is really "attached at every check,
# with no two checks further apart than this". Without the gap test a stamp left
# by a docking an hour ago would read as a settled card the instant this one
# came back.
MIC_SETTLE_GAP="${MIC_SETTLE_GAP:-15}"
SETTLE_FILE="$STATE_DIR/settle"
# The colour last painted. The lamp is HID, so it persists in the card's
# firmware and cannot be read back -- this file is the only record of it, and it
# is what keeps a repeated paint from becoming a repeated firmware write.
# Cleared when the card goes away, because it comes back carrying whatever the
# other machine left on it.
LAMP_FILE="$STATE_DIR/lamp"

log() { printf '%s micctl[%s]: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "${1}" "${2}"; }

# ---------------------------------------------------------------------------
# Devices
# ---------------------------------------------------------------------------

device_exists() {
    # $1 = name, $2 = input|output
    SwitchAudioSource -a -t "$2" 2>/dev/null | grep -Fxq "$1"
}

# Why the card cannot be written to yet, or nothing when it can.
#
# Three tests, each strictly stronger than the one before it:
#
#   attached   CoreAudio lists it as an input at all.
#   answering  it returns its own mute flag. Being listed is not the same as
#              being usable, and that gap is the whole point: the write that
#              failed above went to a device `device_exists` had accepted.
#   settled    both of the above have held at every check for
#              MIC_SETTLE_SECONDS, which a card stuck re-enumerating cannot
#              manage.
#
# The USB tree was considered as a fourth test and left out. `ioreg -p IOUSB`
# sees the device node BEFORE CoreAudio publishes it, so as a gate it is the
# weaker of the two signals and adds nothing on top.
#
# An unpinned device is always ready: there is no card being handed across a
# switch, so there is nothing to wait for. Making every machine pay for this
# one's USB switch is how a module stops being portable.
# The first two tests on their own, without the settle window.
#
# This is the bar for a write that is NOT part of an arrival -- the mute key,
# which can happen at any moment. The settle window cannot be used there and
# that is not a compromise, it is arithmetic: nothing polls any more, so an
# isolated check always lands more than MIC_SETTLE_GAP after the last one and
# restarts the window. Gating the keypress on it would mean the lamp never
# changed on Option+B at all, which is most of what the lamp is for.
#
# The strict version belongs where an arrival is actually being watched, which
# is dockctl: it polls `micctl ready` every five seconds while an assertion is
# armed, so the window gets satisfied there and only there.
mic_attached_reason() {
    [[ -n "$MIC_DEVICE" ]] || return 0
    if ! device_exists "$MIC_DEVICE" input; then
        rm -f "$SETTLE_FILE" "$LAMP_FILE"
        printf "'%s' is not attached" "$MIC_DEVICE"
        return 0
    fi
    if [[ -x "$COREAUDIO_CTL" ]] \
       && ! "$COREAUDIO_CTL" mute get "$MIC_DEVICE" >/dev/null 2>&1; then
        rm -f "$SETTLE_FILE"
        printf "'%s' is listed but not answering yet" "$MIC_DEVICE"
        return 0
    fi
    return 0
}

mic_attached() { [[ -z "$(mic_attached_reason)" ]]; }

mic_ready_reason() {
    local first="" last="" now elapsed why
    why="$(mic_attached_reason)"
    if [[ -n "$why" ]]; then printf '%s' "$why"; return 0; fi
    [[ -n "$MIC_DEVICE" ]] || return 0
    now=$(date '+%s')
    [[ -r "$SETTLE_FILE" ]] && read -r first last < "$SETTLE_FILE"
    if [[ -z "$first" || -z "$last" ]] || (( now - last > MIC_SETTLE_GAP )); then
        first="$now"
    fi
    mkdir -p "$STATE_DIR"
    printf '%s %s\n' "$first" "$now" > "$SETTLE_FILE"
    elapsed=$(( now - first ))
    (( elapsed >= MIC_SETTLE_SECONDS )) && return 0
    # Deliberately the same string for the whole window, so a caller that logs
    # once per distinct reason does not print a countdown. The elapsed figure
    # is in `micctl status`.
    printf "'%s' is still settling after a re-enumeration" "$MIC_DEVICE"
}

mic_ready() { [[ -z "$(mic_ready_reason)" ]]; }

# How far into the settle window the card is, for `status`.
mic_settle_elapsed() {
    local first="" last=""
    [[ -r "$SETTLE_FILE" ]] && read -r first last < "$SETTLE_FILE"
    [[ -n "$first" ]] || return 0
    printf '%s' "$(( $(date '+%s') - first ))"
}

# The device everything here acts on: the card while it is attached, so that
# undocking does not leave the mute key writing to nothing, and the fallback
# otherwise. Deliberately NOT gated on readiness -- see mute_apply.
resolve_mic() {
    local cur
    if [[ -n "$MIC_DEVICE" ]] && device_exists "$MIC_DEVICE" input; then
        printf '%s' "$MIC_DEVICE"
        return
    fi
    cur=$(SwitchAudioSource -t input -c 2>/dev/null)
    if [[ -n "$cur" ]] && device_exists "$cur" input; then
        printf '%s' "$cur"
        return
    fi
    printf '%s' "$MIC_FALLBACK"
}

# The card, skipping the is-it-attached check resolve_mic does. That check is a
# SwitchAudioSource call and costs 41ms measured, which is a third of the
# budget on a path that runs on a keypress. If the card is absent the helper
# just fails, which is the same outcome as resolving elsewhere would be.
mic_device_fast() {
    if [[ -n "$MIC_DEVICE" ]]; then printf '%s' "$MIC_DEVICE"; return; fi
    resolve_mic
}

# ---------------------------------------------------------------------------
# Mute
# ---------------------------------------------------------------------------

# Mute belongs on the capture side of the card, and that is the whole of it.
#
# The obvious implementation is CoreAudio's mute flag on the default input --
# which is now the card itself, so the flag would sit on the very device every
# app is holding. Chrome reads it and Google Meet answers a deliberate Option+B
# with "your microphone is muted" over the top of its own mute button. Being
# told in every call that the thing you just did on purpose is a fault is worse
# than the problem the flag solved.
#
# `coreaudio-ctl mute` therefore writes the capture-side flag on the named
# device rather than going through the default-input API SwitchAudioSource uses
# -- its -m ignores -s and only ever acts on the current default input, which is
# why that helper exists at all. An app reading the device's mute property does
# not see this, and what it captures is digital silence.
#
# Measured through a capture that was already open: peak amplitude 0.000639
# with the mic live, exactly 0.000000 muted. The write reaches an open capture,
# so nothing has to be restarted around it, and it costs 45.5ms.
#
# $1 = 1 | 0 | toggle, $2 = device, defaulting to the card.
# Echoes the state it left behind, so no caller has to read it back.
hw_mute() {
    local want="$1" dev="${2:-}" out rc
    [[ -n "$dev" ]] || dev="$(mic_device_fast)"
    if [[ ! -x "$COREAUDIO_CTL" ]]; then
        echo "$COREAUDIO_CTL is missing -- run ./install.sh audio" >&2
        return 1
    fi
    out="$("$COREAUDIO_CTL" mute set "$dev" "$want" 2>/dev/null)"; rc=$?
    if (( rc == 0 )); then
        [[ "$out" == 1 ]] && printf 'muted' || printf 'live'
        return 0
    fi
    # 3 is specifically "this device has no mute control of its own". Anything
    # else is a write that failed, and claiming a mute that did not happen is
    # the one outcome worth refusing outright.
    if (( rc != 3 )); then
        echo "could not mute '$dev'" >&2
        return 1
    fi
    hw_mute_by_volume "$want" "$dev"
}

# A mic with no mute control of its own: take its input gain to zero instead.
# The same silence and the same invisibility -- measured at 0.000613 at the G6's
# own gain of 0.65 and exactly 0.000000 at zero -- but the level has to be
# remembered across the mute, which is why this is the fallback and not the
# mechanism. Every input measured here has a settable mute flag (the G6, the
# built-in mic, a C920); this is for hardware that does not.
hw_mute_by_volume() {
    local want="$1" dev="$2" now muted=0 back
    if ! now="$("$COREAUDIO_CTL" volume get "$dev" 2>/dev/null)"; then
        echo "'$dev' has neither a mute control nor an input gain" >&2
        return 1
    fi
    awk -v v="$now" 'BEGIN { exit !(v > 0) }' || muted=1
    [[ "$want" == toggle ]] && want=$(( muted ? 0 : 1 ))
    if (( want )); then
        # Never record zero as the level to come back to: that is this
        # function's own work seen on a second mute, and restoring it would
        # leave the mic silent with everything else reporting live.
        (( muted )) || printf '%s\n' "$now" > "$MUTE_VOLUME_FILE"
        "$COREAUDIO_CTL" volume set "$dev" 0 >/dev/null || return 1
        printf 'muted'
    else
        back="$(cat "$MUTE_VOLUME_FILE" 2>/dev/null)"
        [[ -n "$back" ]] || back=1
        "$COREAUDIO_CTL" volume set "$dev" "$back" >/dev/null || return 1
        printf 'live'
    fi
}

# The state, read from the device. Fails, printing nothing, when there is no
# device to ask -- the card is on the other side of the USB switch, or the
# helper was never built.
hw_mute_state() {
    local dev="${1:-}" v
    [[ -x "$COREAUDIO_CTL" ]] || return 1
    [[ -n "$dev" ]] || dev="$(mic_device_fast)"
    if v="$("$COREAUDIO_CTL" mute get "$dev" 2>/dev/null)" && [[ -n "$v" ]]; then
        [[ "$v" == 1 ]] && printf 'muted' || printf 'live'
        return 0
    fi
    # No mute control, so zero input gain is what mute means on this device.
    v="$("$COREAUDIO_CTL" volume get "$dev" 2>/dev/null)" && [[ -n "$v" ]] || return 1
    awk -v x="$v" 'BEGIN { exit !(x > 0) }' && printf 'live' || printf 'muted'
}

# ---------------------------------------------------------------------------
# The settings the card forgets
# ---------------------------------------------------------------------------

# Off by default; see MIC_ASSERT_INPUT_SOURCE above for why, and for the
# measurement that says it is no longer needed.
ensure_input_source() {
    local dev="$1" now
    (( MIC_ASSERT_INPUT_SOURCE )) || return 0
    [[ -n "$MIC_INPUT_SOURCE" ]] || return 0
    [[ -x "$COREAUDIO_CTL" ]] || return 0
    # Only for the card. The setting names a source that device has; asking the
    # built-in microphone for 'External Mic' fails every time and fills the
    # log, which it did while the card was away on the desk machine.
    [[ -z "$MIC_DEVICE" || "$dev" == "$MIC_DEVICE" ]] || return 0
    now="$("$COREAUDIO_CTL" input-source get "$dev" 2>/dev/null)"
    # Empty means the device models no data source at all, so there is nothing
    # to manage and nothing to warn about.
    [[ -n "$now" ]] || return 0
    [[ "$now" == *"$MIC_INPUT_SOURCE"* ]] && return 0
    log claim "input source on '$dev' was '$now', setting '$MIC_INPUT_SOURCE'"
    "$COREAUDIO_CTL" input-source set "$dev" "$MIC_INPUT_SOURCE" >/dev/null 2>&1 \
        || log claim "could not set input source to '$MIC_INPUT_SOURCE'"
}

# Off by default; see MIC_CLAIM_DEFAULT_INPUT above.
ensure_default_input() {
    local cur
    (( MIC_CLAIM_DEFAULT_INPUT )) || return 0
    [[ -n "$MIC_DEVICE" ]] || return 0
    device_exists "$MIC_DEVICE" input || return 0
    cur="$(SwitchAudioSource -t input -c 2>/dev/null)"
    [[ "$cur" == "$MIC_DEVICE" ]] && return 0
    log claim "default input was '$cur', claiming '$MIC_DEVICE'"
    SwitchAudioSource -t input -s "$MIC_DEVICE" >/dev/null 2>&1 || true
}

sidetone_apply() {
    local want="$1" mic
    [[ -n "$MIC_SIDETONE" ]] || return 0
    [[ -x "$COREAUDIO_CTL" ]] || return 0
    mic="$(mic_device_fast)"
    case "$want" in
        on)  "$COREAUDIO_CTL" playthru set "$mic" 1 "$MIC_SIDETONE_DB" >/dev/null 2>&1 || true ;;
        off) "$COREAUDIO_CTL" playthru set "$mic" 0 >/dev/null 2>&1 || true ;;
    esac
}

sidetone_state() {
    local mic v
    [[ -x "$COREAUDIO_CTL" ]] || { printf 'unknown'; return; }
    mic="$(mic_device_fast)"
    v="$("$COREAUDIO_CTL" playthru get "$mic" 2>/dev/null | head -1)"
    case "$v" in
        1) printf 'on' ;;
        0) printf 'off' ;;
        *) printf 'not supported' ;;
    esac
}

# $1 = muted|live.
#
# This is the ONLY write here that goes over HID rather than through CoreAudio,
# which makes it the only one that persists in the card's firmware -- and so the
# only one whose effect outlives the write. That is why it is gated and the
# others are not.
#
# The desk machine gets this right structurally rather than by checking: its
# `claim_lamp` fires once on the absent -> present edge of the guard's own loop,
# and that edge is only reachable after `find_card` has seen the card
# registered with ALSA. Nothing there can paint a card mid-arrival. There is no
# poll loop left here to hang that on, so the check is explicit instead.
#
# Deliberately scoped to lighting only. The same CLI can reach the CrystalVoice
# DSP, which is switched OFF in this card's firmware on purpose because it made
# the mic sound like a phone; `--lighting-rgb` emits only the lighting trio,
# verified with `--dry-run --debug`, so none of that is disturbed here.
rgb_apply() {
    local want
    case "$1" in
        muted) want="$MIC_RGB_MUTED" ;;
        live)  want="$MIC_RGB_LIVE" ;;
        *)     return 0 ;;
    esac
    [[ -n "$want" ]] || return 0
    [[ -x "$G6_CLI" ]] || return 0
    # Attached and answering, not the full settle window -- see
    # mic_attached_reason for why the strict test cannot live on this path.
    # dockctl holds the strict one, and it is the only caller that can.
    if ! mic_attached; then
        log lamp "card is not there to paint: $(mic_attached_reason)"
        return 0
    fi
    # Never write the same colour twice. A no-op paint is still a firmware
    # write, and the card is the thing we are trying to stop poking.
    [[ "$(cat "$LAMP_FILE" 2>/dev/null)" == "$want" ]] && return 0
    # Record the ATTEMPT, before making it, not the success. Recording success
    # would mean a CLI that fails gets retried by every caller that comes
    # along. One attempt per colour per arrival is the whole budget; the record
    # is cleared when the card leaves, so a genuine failure is retried on the
    # next arrival rather than never.
    mkdir -p "$STATE_DIR"
    printf '%s\n' "$want" > "$LAMP_FILE"
    # shellcheck disable=SC2086 -- $want is three separate arguments.
    "$G6_CLI" --lighting-rgb $want >/dev/null 2>&1 \
        || log lamp "could not paint the lamp $want; leaving it until the card returns"
    return 0
}

# ---------------------------------------------------------------------------
# The two things that actually happen
# ---------------------------------------------------------------------------

# toggle, on and off are one function because the device decides the outcome
# rather than a state file: `toggle` is resolved inside the helper, in the same
# process that writes the flag, and all three paths then follow whatever state
# comes back.
#
# The order is load-bearing on both paths. Muting switches the sidetone off
# before repainting the lamp, so you stop hearing yourself the moment you press
# the key; unmuting writes the flag before the lamp goes white, so the lamp is
# never white while you are still inaudible.
#
# The MUTE FLAG IS NOT GATED on the card being settled, and that is deliberate:
# a keypress has to act, and a card mid-restart is a worse reason to swallow
# Option+B than it is to delay a write nobody asked for. The lamp inside
# rgb_apply IS gated, because that one is a firmware write -- so a keypress
# during a re-enumeration still mutes you, and the colour catches up on the
# next press or the next docking.
mute_apply() {
    local want state
    case "$1" in
        on)     want=1 ;;
        off)    want=0 ;;
        toggle) want=toggle ;;
        *)      usage; return 1 ;;
    esac
    mkdir -p "$STATE_DIR"
    state="$(hw_mute "$want")" || return 1
    if [[ "$state" == muted ]]; then
        : > "$MUTE_STATE_FILE"
        sidetone_apply off
        rgb_apply muted
        echo "muted"
    else
        rm -f "$MUTE_STATE_FILE"
        sidetone_apply on
        rgb_apply live
        echo "unmuted"
    fi
}

# Everything worth asserting on a card that has just arrived. This is what
# dockctl runs on docking, behind `micctl ready`.
#
# Unmuted is the state to start from because a mute left over from before the
# handover is invisible by design -- the flag is where no app can see it -- and
# the lamp, which is the one indicator, is on the card that just came back from
# the other machine, where it was set to whatever that machine wanted.
#
# The two input settings are no-ops unless their variables are turned on.
mic_claim() {
    local dev
    dev="$(resolve_mic)"
    ensure_input_source "$dev"
    ensure_default_input
    mute_apply off
}

mute_status() {
    hw_mute_state && { echo; return 0; }
    [[ -e "$MUTE_STATE_FILE" ]] && echo "muted" || echo "live"
}

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

input_source_of() {
    [[ -x "$COREAUDIO_CTL" ]] || return 0
    "$COREAUDIO_CTL" input-source get "$1" 2>/dev/null
}

# Sources that are not a microphone. A device parked on one of these records
# silence however healthy everything else is -- which is exactly how a dead mic
# once hid behind "mic: Sound BlasterX G6" and "usable: yes". The G6
# auto-selects from what is plugged in and falls back to Line In when it finds
# no mic.
#
# Named negatively on purpose. Drivers put arbitrary strings here, so guessing
# which strings mean "microphone" false-positives on anything unexpected. Only
# the inputs that are definitely not a mic get flagged.
input_source_is_mic() {
    case "$1" in
        *[Ll]ine\ [Ii]n*|*S/PDIF*|*SPDIF*|*[Oo]ptical*|*[Dd]igital\ [Ii]n*|*What\ U\ Hear*|*[Aa]ux*)
            return 1 ;;
        *) return 0 ;;
    esac
}

status() {
    local mic src warm
    mic=$(resolve_mic)

    echo "Mute"
    printf '  state          %s\n' "$(mute_status)"
    printf '  applied to     %s  (capture side, where no app can see it)\n' "$mic"
    echo
    echo "Microphone"
    printf '  device         %s%s\n' "$mic" \
        "$(device_exists "$mic" input && echo "" || echo "  [MISSING]")"
    if [[ -n "$MIC_DEVICE" ]]; then
        warm="$(mic_ready_reason)"
        if [[ -n "$warm" ]]; then
            printf '  warm-up        %s -- the lamp is not written until that clears\n' "$warm"
        else
            printf '  warm-up        settled %ss ago\n' "$(mic_settle_elapsed)"
        fi
    fi
    src="$(input_source_of "$mic")"
    if [[ -n "$src" ]]; then
        printf '  input source   %s%s%s\n' "$src" \
            "$(input_source_is_mic "$src" && echo "" || echo "  [NOT A MIC -- records silence]")" \
            "$( (( MIC_ASSERT_INPUT_SOURCE )) && [[ -n "$MIC_INPUT_SOURCE" ]] && echo "  (asserted as '$MIC_INPUT_SOURCE')" || echo "  (not managed)" )"
        if [[ -x "$COREAUDIO_CTL" ]] && ! input_source_is_mic "$src"; then
            "$COREAUDIO_CTL" input-source list "$mic" 2>/dev/null | sed 's/^/                 /'
        fi
    fi
    printf '  default input  %s%s\n' "$(SwitchAudioSource -t input -c 2>/dev/null)" \
        "$( (( MIC_CLAIM_DEFAULT_INPUT )) && echo "  (claimed on arrival)" || echo "  (macOS picks this)" )"
    echo
    echo "Sidetone"
    printf '  device         %s\n' "$(sidetone_state)"
    printf '  wanted         %s\n' \
        "$( [[ -n "$MIC_SIDETONE" ]] && echo "$MIC_SIDETONE at ${MIC_SIDETONE_DB} dB, following mute" || echo "(unmanaged)" )"
    printf '  output         %s\n' "$(SwitchAudioSource -t output -c 2>/dev/null)"
    echo
    echo "Lamp"
    printf '  configured     %s\n' \
        "$( [[ -n "$MIC_RGB_LIVE$MIC_RGB_MUTED" ]] && echo "live '$MIC_RGB_LIVE', muted '$MIC_RGB_MUTED'" || echo "(unmanaged)" )"
    if [[ -n "$MIC_RGB_LIVE$MIC_RGB_MUTED" ]]; then
        # The lamp is HID and does not read back, so this is the record of the
        # last paint rather than a reading. Shown because it is the only mute
        # indicator there is, and "configured" and "painted" come apart
        # whenever the card has been away.
        printf '  painted        %s\n' \
            "$(cat "$LAMP_FILE" 2>/dev/null || echo "nothing since the card last arrived")"
    fi
    echo
    echo "Apps talk to the card directly -- there is no virtual device and no gate"
    echo "any more. Meet, Slack and Teams gate on their own side; OBS has its own."
    echo
    echo "Mute sets the flag on the capture side, so apps see a live device carrying"
    echo "a silent room and cannot tell you are muted. The lamp and the sidetone are"
    echo "the only indicators; nothing will say it for you, which is the point."
    if [[ -n "$src" ]] && ! input_source_is_mic "$src"; then
        echo
        echo "NOTE: '$mic' is set to '$src', which carries no microphone, so every app"
        echo "      is recording silence. Fix it in System Settings > Sound > Input,"
        echo "      or set MIC_ASSERT_INPUT_SOURCE=1 and run 'micctl claim'."
    fi
}

usage() {
    cat <<USAGE
micctl -- mute, sidetone and the mute lamp for the desk microphone

  micctl mute [toggle|on|off|status]   default: toggle  (bound to Option+B)
                                       also switches the sidetone and the lamp.
                                       Mutes the capture side, so apps cannot
                                       see it and cannot object
  micctl sidetone [on|off|status]      the card's analog monitoring
  micctl claim                         assert what a just-arrived card forgets:
                                       unmuted, sidetone on, lamp live. What
                                       dockctl runs once the card has settled
  micctl ready                         exit 0 once the card is attached,
                                       answering and settled. What dockctl waits
                                       for before it writes anything
  micctl status                        devices, mute, sidetone, lamp

There is no chain, no gate and no virtual device any more: apps use the card
directly. Settings live in ~/.config/audio/local.conf; see audio/README.md.
USAGE
}

case "${1:-status}" in
    mute)
        case "${2:-toggle}" in
            toggle|on|off) mute_apply "${2:-toggle}" ;;
            status) mute_status ;;
            *) usage; exit 1 ;;
        esac
        ;;
    sidetone)
        case "${2:-status}" in
            on|off) sidetone_apply "$2"; echo "sidetone $(sidetone_state)" ;;
            status) echo "$(sidetone_state)" ;;
            *) usage; exit 1 ;;
        esac
        ;;
    claim)  mic_claim ;;
    ready)
        why="$(mic_ready_reason)"
        if [[ -n "$why" ]]; then echo "$why"; exit 1; fi
        echo "ready"
        ;;
    status) status ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
