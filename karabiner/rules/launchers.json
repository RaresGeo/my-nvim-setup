{
  "title": "Launchers (dotfiles: karabiner/rules/launchers.json)",
  "rules": [
    {
      "description": "Option+Enter: new Alacritty instance",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "mandatory": [
                "option"
              ],
              "optional": []
            }
          },
          "to": [
            {
              "shell_command": "open -na Alacritty"
            }
          ]
        }
      ]
    },
    {
      "description": "Option+Cmd+Enter: new Alacritty instance running tmux",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "return_or_enter",
            "modifiers": {
              "mandatory": [
                "option",
                "command"
              ],
              "optional": []
            }
          },
          "to": [
            {
              "shell_command": "open -na Alacritty --args -e /bin/zsh -lc 'exec /opt/homebrew/bin/tmux'"
            }
          ]
        }
      ]
    },
    {
      "description": "Option+Shift+B: new window of the default browser",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "b",
            "modifiers": {
              "mandatory": [
                "option",
                "shift"
              ],
              "optional": []
            }
          },
          "to": [
            {
              "shell_command": "\"$HOME/.local/bin/open-browser\""
            }
          ]
        }
      ]
    }
  ]
}
