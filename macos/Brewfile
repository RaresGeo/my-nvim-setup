# macOS base packages. Installed by macos/install.sh via `brew bundle`.

# The installers in this repo need bash 4+; macOS ships 3.2.
brew "bash"

cask "font-jetbrains-mono-nerd-font"

# Shell and editor (the zsh/tmux/nvim modules install their own essentials)
# nvim-treesitter compiles its parsers with the tree-sitter CLI
brew "tree-sitter-cli"
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"
brew "btop"
brew "lazydocker"
brew "gh"
brew "mise"
brew "direnv"
brew "herdr"

# DDC/CI control for the desk monitor: macos/dock/dockctl hands the ultrawide
# back to the other machine on undock. USB-C/DisplayPort only -- displays on the
# built-in HDMI port of M1/entry-M2 Macs are not supported by m1ddc.
brew "m1ddc"
