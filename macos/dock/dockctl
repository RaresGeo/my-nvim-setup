#!/bin/bash
# dockctl -- managed docked/undocked state for this Mac.
#
# The desk keyboard is the signal. It sits behind a USB switch, so when the
# switch hands it to the other machine it vanishes from this Mac's USB tree --
# which is exactly the moment we stopped being docked. No display probing
# needed, and it works before/after the monitor has made up its mind.
#
# What a state change applies:
#   1. Alacritty font size      (via a generated import -- see font_apply)
#   2. OmniWM workspace placement (so nothing is stranded on an invisible panel)
#   3. The desk microphone      (see mic_apply)
#
# Usage:
#   dockctl status          print the detected state and what is currently set
#   dockctl detect          print just docked|undocked, for other scripts
#   dockctl apply           apply, but only if the state changed since last run
#   dockctl apply --force   apply unconditionally
#   dockctl watch           apply in a loop; this is what the launchd agent runs
#   dockctl dock            force docked  (manual override, ignores hardware)
#   dockctl undock          force undocked
#   dockctl probe           dump what the detector sees (use this at the desk)
#
# Set MIC_APPLY=0 to leave the microphone alone on docking.

set -euo pipefail

# --- what identifies the dock -------------------------------------------------
# SONiX USB keyboard, 0x0C45:0x7016. Confirm with `dockctl probe` while docked.
DOCK_USB_VENDOR="${DOCK_USB_VENDOR:-3141}"
DOCK_USB_PRODUCT="${DOCK_USB_PRODUCT:-28694}"

# --- the two sizes ------------------------------------------------------------
# Docked: the 34" 1440p ultrawide is 109 PPI and runs at native 1x, because
# macOS fractional scaling resamples and looks blurry. So the app has to carry
# the readability itself: 14 * 1.25. Undocked: the Retina panel already scales,
# so the plain value is correct and anything else fights the compositor.
FONT_SIZE_DOCKED="${FONT_SIZE_DOCKED:-18}"
FONT_SIZE_UNDOCKED="${FONT_SIZE_UNDOCKED:-14}"



ALACRITTY_OVERLAY="${ALACRITTY_OVERLAY:-$HOME/.config/alacritty/dock.toml}"
ALACRITTY_CONFIG="${ALACRITTY_CONFIG:-$HOME/.config/alacritty/alacritty.toml}"

# Undocking does not unplug the Dell -- the cable stays, only its input changes --
# so macOS keeps it as a live display and anything parked there becomes invisible
# rather than gone. OmniWM cannot see that, so this script owns where workspaces
# live: settings.toml leaves them all on "main" and the layout is declared here.
# Set to 0 to leave workspaces alone.
DOCK_MOVE_WORKSPACES="${DOCK_MOVE_WORKSPACES:-1}"
# Substring identifying the built-in panel in OmniWM's display names.
WS_INTERNAL_MATCH="${WS_INTERNAL_MATCH:-Built-in}"
# Which workspaces stay on the built-in panel WHILE DOCKED; every other one goes
# to the external panel. Undocked, all of them come home -- it is the only panel
# you can see.
WS_INTERNAL_WORKSPACES="${WS_INTERNAL_WORKSPACES:-10}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dock"
STATE_FILE="$STATE_DIR/state"

say() { printf '%s\n' "$*"; }
note() { printf '  %s\n' "$*"; }

# --- detection ----------------------------------------------------------------
# `ioreg -p IOUSB -l` is ~17ms, which is what makes polling cheap. Reset the
# vendor/product flags at every `+-o` so the pair has to match on ONE device
# rather than coincidentally across two.
dock_present() {
    ioreg -p IOUSB -l -w0 2>/dev/null | awk \
        -v v="$DOCK_USB_VENDOR" -v p="$DOCK_USB_PRODUCT" '
        /^[ |]*\+-o /                 { iv = 0; ip = 0 }
        $0 ~ "\"idVendor\" = " v "$"  { iv = 1 }
        $0 ~ "\"idProduct\" = " p "$" { ip = 1 }
        iv && ip                      { found = 1; exit }
        END                           { exit(found ? 0 : 1) }
    '
}

detect_state() { dock_present && say docked || say undocked; }

# --- 1. Alacritty -------------------------------------------------------------
# The size lives in this generated import, NOT in alacritty.toml. Alacritty
# loads the importing file LAST, so a `size` in alacritty.toml would always beat
# an import and the overlay would silently do nothing.
font_apply() {
    local size="$1"
    mkdir -p "$(dirname "$ALACRITTY_OVERLAY")"
    cat > "$ALACRITTY_OVERLAY" <<EOF
# Generated by dockctl -- do not edit, it is rewritten on every dock change.
# Lives here rather than in alacritty.toml because Alacritty loads the
# importing file last, so a size there would override this import.
[font]
size = $size
EOF
    # Nudge the running Alacritty, or the new size sits on disk unused. Its
    # watcher reloads only when an event path is already in the config's `paths`
    # list, and that list is captured when the config is LOADED -- so an instance
    # started before dock.toml joined the imports ignores writes to it outright.
    # The main config is always in that list. `touch -h` bumps the symlink itself
    # rather than the repo file it points at, whose directory is not watched at
    # all, which is why editing the repo copy never reloads anything.
    if [[ -L "$ALACRITTY_CONFIG" || -f "$ALACRITTY_CONFIG" ]]; then
        touch -h "$ALACRITTY_CONFIG" 2>/dev/null || true
    fi
    note "alacritty font size -> $size  ($ALACRITTY_OVERLAY)"
}

# --- 2. Zen: deliberately NOT managed ----------------------------------------
# Removed after measuring it. layout.css.devPixelsPerPx at -1.0 ("follow macOS")
# is correct in BOTH states: 2.0 on the built-in XDR, and 1.0 on the Dell, which
# runs at native 1x. There is no per-state value to choose, so there is nothing
# to automate -- the pref is left at -1.0 in the profile's user.js and dockctl
# does not touch it. The earlier 1.25 came from treating the pref as a readability
# boost, but it REPLACES the macOS backing scale instead of multiplying it, which
# is what made Zen render at 62.5% on the laptop.

# --- 2. OmniWM workspace placement -------------------------------------------
# Same PATH trap as everything else launchd runs: resolve the binary rather than
# trusting $PATH, which has no Homebrew in it.
find_omniwmctl() {
    local c
    for c in "${DOCK_OMNIWMCTL:-}" /opt/homebrew/bin/omniwmctl \
             /Applications/OmniWM.app/Contents/MacOS/omniwmctl; do
        if [[ -n "$c" && -x "$c" ]]; then printf '%s\n' "$c"; return 0; fi
    done
    command -v omniwmctl 2>/dev/null || return 1
}

# The external panel's name, from OmniWM's DISPLAY list. It cannot come from the
# workspace list: after a successful undock move every workspace sits on the
# built-in, so there is nothing left pointing at the Dell to read its name from
# and the restore could never run.
external_display() {
    "$1" query displays --format json 2>/dev/null | /usr/bin/python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
m=sys.argv[1]
for disp in d.get("result",{}).get("payload",{}).get("displays",[]):
    name=disp.get("name","")
    if name and m not in name:
        print(name); break
' "$2"
}

# "<number>\t<display name>" per workspace.
ws_map() {
    "$1" query workspaces --format json 2>/dev/null | /usr/bin/python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for w in d.get("result",{}).get("payload",{}).get("workspaces",[]):
    print("%s\t%s" % (w.get("number"), (w.get("display") or {}).get("name","")))
'
}

ws_display_of() { ws_map "$1" | awk -F'\t' -v n="$2" '$1==n {print $2; exit}'; }

# move-to-monitor takes a DIRECTION, not a display, and OmniWM's idea of which way
# a panel lies follows neither the frame geometry nor the routing arrangement:
# with the built-in at gridColumn 0 and the Dell at 1, moving a workspace from the
# Dell to the built-in still answers to "right". So the direction is discovered by
# trying and checking, and cached per target -- one run can move workspaces both
# ways, and a single cache would send the second direction the wrong way.
#
# --force stays even though settings.toml no longer pins workspaces: this script
# is the owner of placement, so a move should not be refused on the strength of
# OmniWM's own idea of where a workspace lives.
ws_dir_internal=""
ws_dir_external=""
ws_borrowed=""
ws_moved=""
ws_stuck=""
ws_failed=""
ws_pinned=""
ws_move_one() {
    local ctl="$1" ws="$2" want="$3" dir out hint
    if [[ "$want" == "$WS_INTERNAL_MATCH" ]]; then hint="$ws_dir_internal"; else hint="$ws_dir_external"; fi
    for dir in $hint left right up down; do
        out="$("$ctl" workspace move-to-monitor "$ws" "$dir" --force 2>&1)" || true
        case "$out" in
            *workspace_state_conflict*)
                # Measured, because the first reading of this was wrong: being shown
                # is fine and having windows is fine -- a VISIBLE workspace WITH
                # windows moves. What OmniWM will not move is a workspace holding a
                # natively fullscreened window, because macOS has pinned that window
                # to its own Space on one display. That refusal survives anything
                # ws_unstick can do, so the caller asks ws_fullscreen_pinned before
                # trying to recover. No direction gets past the conflict either way,
                # so stop trying them.
                return 2 ;;
        esac
        if [[ "$(ws_display_of "$ctl" "$ws")" == *"$want"* ]]; then
            if [[ "$want" == "$WS_INTERNAL_MATCH" ]]; then ws_dir_internal="$dir"
            else ws_dir_external="$dir"; fi
            return 0
        fi
    done
    return 1
}

# The one refusal nothing can clear. macOS gives a natively fullscreened window
# its own Space, bound to the display it was fullscreened on, and OmniWM cannot
# drag a workspace holding one to another panel -- the move answers
# workspace_state_conflict however the workspace is shown. Recognising it is what
# keeps the recovery below from being attempted forever against a wall.
ws_fullscreen_pinned() {
    "$1" query windows --workspace "$2" --format json 2>/dev/null | /usr/bin/python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
for w in d.get("result",{}).get("payload",{}).get("windows",[]):
    if w.get("layoutReason") == "native-fullscreen": sys.exit(0)
sys.exit(1)
'
}

# A fingerprint of the attached panels. Placement has to be reconciled when the
# display set changes and not only when the dock state does: with nothing pinned
# in settings.toml, OmniWM puts a workspace on whatever is "main" when a panel
# appears, and plugging the Dell in while the keyboard is already attached is not
# a dock-state change, so nothing would otherwise put workspace 10 back.
display_signature() {
    local ctl
    ctl="$(find_omniwmctl)" || { printf '%s\n' '?'; return 0; }
    "$ctl" query displays --format json 2>/dev/null | /usr/bin/python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: print("?"); sys.exit(0)
names=sorted(x.get("name","") for x in d.get("result",{}).get("payload",{}).get("displays",[]))
print("|".join(n for n in names if n) or "?")
' || printf '%s\n' '?'
}

# Show some other workspace on the panel this one is stuck to, which is what
# makes it movable. Any other workspace already on that panel will do; if it is
# the only one there, nothing can take its place and it stays put.
#
# This is VISIBLE: it parks a workspace on the other panel and switches to it,
# and the panel it came from lands on whatever is left. That is a fair price on
# an actual dock change and no price at all to pay every five seconds, so the
# periodic reconcile does not call it -- see workspaces_apply.
# An empty workspace that is not on this panel. Empty ones are the safe thing to
# borrow: being empty they can be moved even while shown, so giving one back is
# never itself blocked.
ws_empty_elsewhere() {
    "$1" query workspaces --format json 2>/dev/null | /usr/bin/python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
disp=sys.argv[1]
for w in d.get("result",{}).get("payload",{}).get("workspaces",[]):
    if (w.get("display") or {}).get("name","") != disp and not (w.get("counts") or {}).get("total",0):
        print(w.get("number")); break
' "$2"
}

ws_unstick() {
    local ctl="$1" ws="$2" disp="$3" other
    other="$(ws_map "$ctl" | awk -F'\t' -v me="$ws" -v d="$disp" '$1 != me && $2 == d {print $1; exit}')"
    if [[ -z "$other" ]]; then
        # It is the only workspace on that panel, so there is nothing there to
        # show in its place. Park an empty one on the panel, which is enough to
        # free this one; the second sweep sends the borrowed one home.
        other="$(ws_empty_elsewhere "$ctl" "$disp")"
        [[ -n "$other" ]] || return 1
        ws_move_one "$ctl" "$other" "$disp" || return 1
        ws_borrowed="$ws_borrowed $other"
    fi
    "$ctl" command switch-workspace anywhere "$other" >/dev/null 2>&1 || return 1
    return 0
}

ws_wants_internal() {
    local ws="$1" n
    for n in $WS_INTERNAL_WORKSPACES; do [[ "$n" == "$ws" ]] && return 0; done
    return 1
}

# Declarative on purpose: work out where every workspace BELONGS in this state
# and move the ones that are elsewhere. The earlier version recorded what it had
# moved and replayed that list in reverse, which went wrong in two ways -- the
# record could be clobbered, and it could not tell a workspace OmniWM had shifted
# on its own from one it had placed. Comparing against the wanted layout needs no
# memory at all, so it is idempotent and self-correcting: a run that is already
# right does nothing, and a run after something drifted puts it back.
ws_sweep() {
    local ctl="$1" state="$2" unstick="$3" ext ws name want rc

    # From the display list, not the workspace list: when every workspace is on
    # the built-in there is nothing left pointing at the external panel.
    ext="$(external_display "$ctl" "$WS_INTERNAL_MATCH")"

    while IFS=$'\t' read -r ws name; do
        [[ -n "$ws" ]] || continue
        if [[ "$state" == "docked" && -n "$ext" ]] && ! ws_wants_internal "$ws"; then
            want="$ext"
        else
            want="$WS_INTERNAL_MATCH"
        fi
        # Already where it belongs. Skipping also keeps ws_move_one from trying a
        # direction that would push it off a display it is correctly on.
        [[ "$name" == *"$want"* ]] && continue
        rc=0; ws_move_one "$ctl" "$ws" "$want" || rc=$?
        if (( rc == 2 )); then
            # Pinned by macOS, not by OmniWM's bookkeeping: no recovery exists,
            # so do not spend a disruptive one on it.
            if ws_fullscreen_pinned "$ctl" "$ws"; then
                ws_pinned="$ws_pinned $ws"
                continue
            fi
            if (( unstick )) && ws_unstick "$ctl" "$ws" "$name"; then
                rc=0; ws_move_one "$ctl" "$ws" "$want" || rc=$?
            fi
        fi
        case "$rc" in
            0) ws_moved="$ws_moved $ws" ;;
            2) ws_stuck="$ws_stuck $ws" ;;
            *) ws_failed="$ws_failed $ws" ;;
        esac
    done < <(ws_map "$ctl")
    return 0
}

tidy() { printf '%s\n' $1 | awk 'NF' | sort -n -u | paste -sd' ' -; }

# `quiet` means this is the every-5s reconcile rather than a dock change, and it
# buys two things beyond a shorter log. The recovery dance is not attempted: it
# is visible, and a workspace it cannot free is one it cannot free on the next
# poll either, so repeating it just flips the screen to an empty workspace every
# five seconds -- which is exactly what undocking with a fullscreen window parked
# on the Dell used to do, forever. And a blocked workspace is reported only when
# the set of them changes, so the log says it once instead of 17,000 times.
workspaces_apply() {
    local state="$1" quiet="${2:-}" ctl pass unstick=1 blocked last_blocked
    (( DOCK_MOVE_WORKSPACES )) || return 0
    if ! ctl="$(find_omniwmctl)"; then
        note "workspaces: omniwmctl not found, skipped"
        return 0
    fi
    "$ctl" ping >/dev/null 2>&1 || { note "workspaces: OmniWM not responding, skipped"; return 0; }
    [[ -n "$quiet" ]] && unstick=0

    ws_moved=""; ws_stuck=""; ws_failed=""; ws_pinned=""
    for pass in 1 2; do
        ws_borrowed=""
        ws_sweep "$ctl" "$state" "$unstick"
        # If a sweep had to park an empty workspace on a panel to free the one
        # stuck there, run the comparison again to send it home. Nothing is
        # remembered between sweeps -- the second one just sees it out of place.
        [[ -n "$ws_borrowed" ]] || break
    done

    # Nothing is recorded any more; drop a file an older version may have left.
    rm -f "$STATE_DIR/moved-workspaces"

    mkdir -p "$STATE_DIR"
    blocked="$(tidy "$ws_pinned$ws_stuck$ws_failed")"
    last_blocked="$( [[ -f "$STATE_DIR/blocked" ]] && cat "$STATE_DIR/blocked" || true )"
    printf '%s\n' "$blocked" > "$STATE_DIR/blocked"

    [[ -n "$ws_moved" ]] && note "workspaces moved: $(tidy "$ws_moved")"
    if [[ -z "$quiet" || "$blocked" != "$last_blocked" ]]; then
        [[ -n "$ws_pinned" ]] && note "workspaces held by a fullscreen window, left put: $(tidy "$ws_pinned") -- leave fullscreen and the next poll moves them"
        [[ -n "$ws_stuck" ]]  && note "workspaces left put (OmniWM refused, nothing to borrow): $(tidy "$ws_stuck")"
        [[ -n "$ws_failed" ]] && note "workspaces could not move: $(tidy "$ws_failed")"
    fi
    [[ -z "$ws_moved$blocked" && -z "$quiet" ]] && note "workspaces: already placed"
    return 0
}

# --- 3. The desk microphone ---------------------------------------------------
# The Sound BlasterX G6 rides the same USB switch as the keyboard, so docking is
# also the moment this Mac takes the microphone back from the desk machine.
#
# Two of the card's settings are USB-audio-class controls, which means volatile:
# the device resets them to its own defaults on every re-enumeration, and taking
# it across the switch is a re-enumeration. Worse, the desk machine wants the
# opposite of what this one wants -- it monitors in software, so it deliberately
# switches the card's analog sidetone OFF while it holds it. Neither setting can
# be assumed; both have to be asserted on arrival.
#
# So on docking: unmute, lamp white, sidetone on. Starting from a known state
# matters because a mute left over from before the handover is invisible by
# design -- micctl mutes the microphone rather than the sink precisely so that
# nothing can see it -- and the lamp, which is the one indicator, is on the card
# that just came back from the other machine.
#
# Only on the transition into docked. Asserting this every poll would fight the
# mute key: press Option+B and five seconds later the watcher would unmute you.
MIC_APPLY="${MIC_APPLY:-1}"

find_micctl() {
    local c
    for c in "${DOCK_MICCTL:-}" "$HOME/.local/bin/micctl"; do
        if [[ -n "$c" && -x "$c" ]]; then printf '%s\n' "$c"; return 0; fi
    done
    return 1
}

mic_apply() {
    local state="$1" ctl
    (( MIC_APPLY )) || return 0
    [[ "$state" == docked ]] || return 0
    find_micctl >/dev/null || return 0
    ctl="$(find_micctl)"
    # `mute off` paints the lamp white and switches the sidetone on by itself --
    # that is the unmute path in micctl, and duplicating it here would mean two
    # places to keep in step.
    if out="$("$ctl" mute off 2>&1)"; then
        note "microphone: $out, lamp white, sidetone on"
    else
        note "microphone: could not reach it ($out)"
    fi
}

# --- 4. Monitor input: deliberately NOT done here -----------------------------
# Moved to the desktop. Two reasons, both measured:
#
#   * This Mac cannot speak DDC to the Dell at all. Every read fails with
#     "DDC communication failure: (iokit/?) unknown subsystem error" -- an
#     I2C-level failure, not an unsupported-VCP reply. The link is a USB-C
#     (DP Alt Mode) to HDMI cable, and that active protocol conversion does not
#     carry the DDC sideband. Nothing on this side fixes that.
#   * The desktop can, in both directions, including while the panel is showing
#     this Mac's HDMI-1 -- verified with `dell-input status` returning
#     "HDMI-1 (sl=0x11)" from Arch over DP-1 with the Mac on screen.
#
# So the desktop owns the handover via its own dell-input script, triggered by
# the keyboard arriving or leaving. For the record, the panel's VCP 0x60 values
# are dp1=0x0f, hdmi1=0x11, hdmi2=0x12; this Mac is on HDMI-1.

apply_state() {
    local state="$1"
    say "applying: $state"
    case "$state" in
        docked)   font_apply "$FONT_SIZE_DOCKED" ;;
        undocked) font_apply "$FONT_SIZE_UNDOCKED" ;;
        *) say "unknown state: $state" >&2; return 1 ;;
    esac
    mkdir -p "$STATE_DIR"
    workspaces_apply "$state"
    mic_apply "$state"
    printf '%s\n' "$state" > "$STATE_FILE"
    display_signature > "$STATE_DIR/displays"
}

current_font_size() {
    [[ -f "$ALACRITTY_OVERLAY" ]] && awk -F'= *' '/^size/ {print $2}' "$ALACRITTY_OVERLAY" || say "(overlay missing)"
}

cmd="${1:-status}"
case "$cmd" in
    # Just the state, nothing else, so other scripts have a contract to read
    # instead of parsing `status`. The audio module gates mic monitoring on
    # this: sidetone is only wanted at the desk, where there is a headset.
    detect) detect_state ;;
    status)
        detected="$(detect_state)"
        say "detected:   $detected"
        say "last applied: $( [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || say '(never)' )"
        say "alacritty size: $(current_font_size)"
        say "displays:   $(display_signature)"
        if [[ -s "$STATE_DIR/blocked" ]]; then
            say "workspaces stuck: $(cat "$STATE_DIR/blocked")"
        fi
        ;;
    apply)
        detected="$(detect_state)"
        last="$( [[ -f "$STATE_FILE" ]] && cat "$STATE_FILE" || true )"
        sig="$(display_signature)"
        last_sig="$( [[ -f "$STATE_DIR/displays" ]] && cat "$STATE_DIR/displays" || true )"
        if [[ "${2:-}" == "--force" || "$detected" != "$last" || "$sig" != "$last_sig" ]]; then
            apply_state "$detected"
        else
            # Placement drifts without either signal moving: OmniWM re-places
            # workspaces on whatever is "main" of its own accord, and merely
            # reloading settings.toml is enough to trigger it. Observed putting
            # every workspace on the Dell while undocked, which is the state all
            # of this exists to prevent. The reconcile is idempotent and costs
            # one query when nothing is wrong, so just run it every poll; it is
            # quiet unless it actually moves something.
            workspaces_apply "$detected" quiet
        fi
        ;;
    watch)
        # Resident loop, because launchd's StartInterval could not be trusted to
        # keep this alive. A 5s interval is below launchd's 10s "minimum runtime",
        # so every poll looked like a process exiting too soon -- launchd throttles
        # those, and a wake from sleep fires all the intervals missed while asleep
        # at once. That burst is what eventually wedged the job: `launchctl print`
        # showed `properties = ... penalty box`, `last exit code = 78: EX_CONFIG`
        # and `job state = spawn failed`, with the run count frozen, and it stayed
        # that way until the agent was booted out and back in by hand.
        #
        # It failed at the worst possible moment every time: undocking means
        # closing the lid, the lid is a clamshell sleep, and the wake from that
        # sleep is exactly the event that killed the watcher -- so the undock it
        # was supposed to apply was the one it was no longer alive to see.
        # pmset put the death at the 14:18:51 lid wake on 2026-10-05, three
        # sleep/wake cycles before anyone noticed.
        #
        # Staying resident removes the whole class of failure: one process, no
        # respawns to throttle, and `sleep` simply resumes when the Mac wakes.
        # Re-exec rather than calling apply inline so a transient failure inside
        # one poll cannot take the loop down with it.
        interval="${DOCK_WATCH_INTERVAL:-5}"
        while :; do
            "$0" apply || true
            sleep "$interval"
        done
        ;;
    dock)   apply_state docked ;;
    undock) apply_state undocked ;;
    probe)
        say "looking for idVendor=$DOCK_USB_VENDOR idProduct=$DOCK_USB_PRODUCT"
        dock_present && say "=> MATCHED (docked)" || say "=> no match (undocked)"
        say ""
        say "USB devices currently visible:"
        # Flush at the NEXT device header, not on idProduct: ioreg prints the
        # two ids in either order, so both have to be in hand before printing.
        ioreg -p IOUSB -l -w0 2>/dev/null | awk '
            function flush() {
                if (name != "" && (v != "" || p != ""))
                    printf "  %-44s %s:%s\n", name, (v == "" ? "?" : v), (p == "" ? "?" : p)
            }
            /^[ |]*\+-o / {
                flush()
                name = $0; sub(/^[ |+-]*o /, "", name); sub(/ *<class.*/, "", name)
                v = ""; p = ""
            }
            /"idVendor" = /  { v = $NF }
            /"idProduct" = / { p = $NF }
            END { flush() }
        '
        ;;
    # Print the header block rather than a line range. The range was hardcoded
    # and silently truncated the usage text every time a line was added above it,
    # which happened three times. This stops at the first line that is neither a
    # comment nor blank, so it cannot drift. awk also strips the "# " correctly:
    # BSD sed has no \? quantifier, so the old `s|^# \?||` matched a literal "?"
    # and left every line with its comment marker on.
    *) awk 'NR > 1 { if ($0 !~ /^#/ && $0 !~ /^[[:space:]]*$/) exit; sub(/^# ?/, ""); print }' "$0"
       exit 1 ;;
esac
