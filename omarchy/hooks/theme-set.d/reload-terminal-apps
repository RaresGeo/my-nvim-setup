#!/bin/bash

# Omarchy theme-set hook: hotswap tmux, zsh, and neovim themes.
#
# Omarchy regenerates the themed templates on every theme change, but the
# running terminal apps have already read the old ones. This pokes each of them
# so a theme switch lands without restarting anything.
#
# Installed by omarchy/install.sh into ~/.config/omarchy/hooks/theme-set.d/

# Reload tmux if running
if command -v tmux &>/dev/null && tmux list-sessions &>/dev/null; then
    tmux source-file ~/.tmux.conf 2>/dev/null
fi

# Signal running neovim instances to reload colorscheme
for addr in /run/user/$(id -u)/nvim.*.0 /tmp/nvim.*/0; do
    if [[ -S "$addr" ]]; then
        nvim --server "$addr" --remote-send '<Cmd>doautocmd FocusGained<CR>' 2>/dev/null &
    fi
done

# Signal running zsh shells to reload theme
# Send USR1 to interactive zsh processes owned by the current user
pkill -USR1 -u "$(id -u)" zsh 2>/dev/null
